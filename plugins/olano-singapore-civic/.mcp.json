{
  "mcpServers": {
    "singapore-civic": {
      "command": "npx",
      "args": ["-y", "@olano/mcp-singapore@0.4.0", "--profile", "civic"],
      "env": {
        "DATA_GOV_SG_API_KEY": "${user_config.data_gov_sg_api_key}",
        "ONEMAP_TOKEN": "${user_config.onemap_token}"
      }
    }
  }
}
