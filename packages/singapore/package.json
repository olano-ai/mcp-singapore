{
  "name": "@olano/mcp-singapore",
  "version": "0.4.1",
  "mcpName": "io.github.olano-ai/mcp-singapore",
  "description": "Unified MCP server for Singapore public data and services",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/olano-ai/mcp-singapore.git",
    "directory": "packages/singapore"
  },
  "homepage": "https://github.com/olano-ai/mcp-singapore#readme",
  "bugs": {
    "url": "https://github.com/olano-ai/mcp-singapore/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "singapore",
    "data.gov.sg",
    "onemap",
    "lta",
    "mrt",
    "hdb",
    "olano"
  ],
  "bin": {
    "mcp-singapore": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "@olano/mcp-analytics": "0.4.1",
    "@olano/mcp-catalog": "0.4.1",
    "@olano/mcp-core": "0.4.1",
    "@olano/mcp-datagov": "0.4.1",
    "@olano/mcp-finance-sg": "0.4.1",
    "@olano/mcp-insights-sg": "0.4.1",
    "@olano/mcp-lta": "0.4.1",
    "@olano/mcp-onemap": "0.4.1",
    "@olano/mcp-rail-sg": "0.4.1",
    "@olano/mcp-weather": "0.4.1",
    "zod": "^4.1.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
