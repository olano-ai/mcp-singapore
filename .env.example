# Optional for public data.gov.sg calls; recommended for production usage.
DATA_GOV_SG_API_KEY=

# Required by OneMap API operations.
ONEMAP_TOKEN=

# Required by every LTA DataMall dynamic API tool.
LTA_DATAMALL_API_KEY=

# Optional persistent cache for public API responses. Disabled by default.
OLANO_SG_CACHE_DIR=

# Optional aggregate-server tool profile: all, mobility, property, business, economy, civic, finance.
OLANO_SG_PROFILE=all
